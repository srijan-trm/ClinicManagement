-- 1. Patients
CREATE TABLE patients (
    patient_id    SERIAL PRIMARY KEY,
    name          VARCHAR(100) NOT NULL,
    gender        VARCHAR(10) CHECK (gender IN ('Male', 'Female', 'Other')),
    date_of_birth DATE,
    blood_group   VARCHAR(5) CHECK (blood_group IN ('A+','A-','B+','B-','O+','O-','AB+','AB-')),
    phone         VARCHAR(15) UNIQUE NOT NULL,
    email         VARCHAR(100) UNIQUE,
    address       VARCHAR(255),
    created_at    TIMESTAMP DEFAULT NOW()
);

-- 2. Doctors
CREATE TABLE doctors (
    doctor_id      SERIAL PRIMARY KEY,
    name           VARCHAR(100) NOT NULL,
    specialization VARCHAR(100),
    phone          VARCHAR(15) UNIQUE NOT NULL,
    email          VARCHAR(100) UNIQUE,
    created_at     TIMESTAMP DEFAULT NOW()
);

-- 3. Doctor schedules
CREATE TABLE doctor_schedules (
    schedule_id   SERIAL PRIMARY KEY,
    doctor_id     INT REFERENCES doctors(doctor_id) ON DELETE CASCADE,
    day_of_week   VARCHAR(10) NOT NULL CHECK (day_of_week IN
                  ('Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday')),
    start_time    TIME NOT NULL,
    end_time      TIME NOT NULL,
    slot_duration INT DEFAULT 30,
    UNIQUE (doctor_id, day_of_week)
);

-- 4. Appointments
CREATE TABLE appointments (
    appointment_id   SERIAL PRIMARY KEY,
    patient_id       INT REFERENCES patients(patient_id) ON DELETE RESTRICT,
    doctor_id        INT REFERENCES doctors(doctor_id) ON DELETE RESTRICT,
    appointment_date TIMESTAMP NOT NULL,
    status           VARCHAR(20) DEFAULT 'Scheduled'
                     CHECK (status IN ('Scheduled', 'Completed', 'Cancelled')),
    notes            TEXT,
    created_at       TIMESTAMP DEFAULT NOW(),
    UNIQUE (doctor_id, appointment_date)
);

-- 5. Patient health (vitals + medical history merged)
CREATE TABLE patient_health (
    health_id          SERIAL PRIMARY KEY,
    patient_id         INT UNIQUE REFERENCES patients(patient_id) ON DELETE CASCADE,

    -- Vitals
    height_cm          DECIMAL(5,2),
    weight_kg          DECIMAL(5,2),
    blood_pressure     VARCHAR(20),         -- e.g. '120/80'
    bmi                DECIMAL(4,2),

    -- Medical history
    allergies          TEXT,                -- e.g. 'Penicillin, Dust'
    chronic_conditions TEXT,               -- e.g. 'Diabetes Type 2, Hypertension'
    past_illnesses     TEXT,               -- e.g. 'Typhoid (2019), Dengue (2021)'
    current_medications TEXT,              -- e.g. 'Metformin 500mg'
    family_history     TEXT,               -- e.g. 'Father: Heart disease'

    updated_at         TIMESTAMP DEFAULT NOW()
);

-- 6. Patient visits (one row per completed appointment)
CREATE TABLE patient_visits (
    visit_id       SERIAL PRIMARY KEY,
    patient_id     INT REFERENCES patients(patient_id) ON DELETE RESTRICT,
    appointment_id INT UNIQUE REFERENCES appointments(appointment_id) ON DELETE RESTRICT,
    doctor_id      INT REFERENCES doctors(doctor_id) ON DELETE RESTRICT,
    visit_date     TIMESTAMP NOT NULL,
    diagnosis      TEXT,
    treatment_notes TEXT,
    follow_up_date  DATE,
    created_at     TIMESTAMP DEFAULT NOW()
);

-- 7. Medicines
CREATE TABLE medicines (
    medicine_id  SERIAL PRIMARY KEY,
    name         VARCHAR(100) NOT NULL UNIQUE,
    category     VARCHAR(50),
    unit         VARCHAR(20),
    price        DECIMAL(10,2) NOT NULL CHECK (price >= 0),
    stock        INT DEFAULT 0 CHECK (stock >= 0)
);

-- 8. Prescriptions (junction: appointments <-> medicines)
CREATE TABLE prescriptions (
    prescription_id SERIAL PRIMARY KEY,
    appointment_id  INT REFERENCES appointments(appointment_id) ON DELETE CASCADE,
    medicine_id     INT REFERENCES medicines(medicine_id) ON DELETE RESTRICT,
    dosage          VARCHAR(100),
    duration_days   INT CHECK (duration_days > 0),
    quantity        INT DEFAULT 1 CHECK (quantity > 0)
);

-- 9. Billing
CREATE TABLE billing (
    bill_id           SERIAL PRIMARY KEY,
    appointment_id    INT UNIQUE REFERENCES appointments(appointment_id) ON DELETE RESTRICT,
    consultation_fee  DECIMAL(10,2) NOT NULL DEFAULT 0,
    medicines_total   DECIMAL(10,2) NOT NULL DEFAULT 0,
    total_amount      DECIMAL(10,2) NOT NULL DEFAULT 0,
    payment_status    VARCHAR(20) DEFAULT 'Pending'
                      CHECK (payment_status IN ('Pending', 'Paid', 'Waived')),
    payment_mode      VARCHAR(20) CHECK (payment_mode IN ('Cash', 'Card', 'UPI')),
    payment_date      DATE,
    created_at        TIMESTAMP DEFAULT NOW()
);